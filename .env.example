# Debe ser IGUAL a la "Clave secreta" que pongas en Integraciones del sistema
SECRET=cambia-esto-por-una-clave-larga

# Si usas Caddy/Nginx delante, deja 127.0.0.1
HOST=127.0.0.1
PORT=3000

# Carpeta donde se guarda la sesión de WhatsApp (haz copia de esta carpeta)
AUTH_DIR=./auth

# Pausa aleatoria entre mensajes (segundos), para parecer uso humano
MIN_DELAY=3
MAX_DELAY=8
